# Copy to backend/.env and adjust. All values have sensible local defaults (see app/core/config.py).
API_PORT=5002
JWT_SECRET=replace-with-a-long-random-string

SQLITE_PATH=data/users.db

DYNAMODB_ENDPOINT=http://localhost:8002
DYNAMODB_TABLE=node

# Must match docker/.env (S3_ACCESS_KEY / S3_SECRET_KEY)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
