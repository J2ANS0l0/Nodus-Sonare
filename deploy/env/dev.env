# Configuration of the "dev" environment (no secrets: JWT_SECRET is generated by deploy.sh on every deploy).
# Same image as every other environment; only these values change.
APP_ENV=dev
HOST_PORT=5002

# Own data in the shared DynamoDB Local / Silo containers (docker/docker-compose.yml)
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE=node_dev
S3_ENDPOINT=http://silo:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
BUCKET_MUSIC=dev-music
BUCKET_MUSIC_COVER=dev-music-cover
BUCKET_PROFILE_PICTURE=dev-profile-picture
