# Configuration of the "staging" environment (no secrets: JWT_SECRET is generated by deploy.sh on every deploy).
# Same image as every other environment; only these values change.
APP_ENV=staging
HOST_PORT=5003

# Own data in the shared DynamoDB Local / Silo containers (docker/docker-compose.yml)
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE=node_staging
S3_ENDPOINT=http://silo:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
BUCKET_MUSIC=staging-music
BUCKET_MUSIC_COVER=staging-music-cover
BUCKET_PROFILE_PICTURE=staging-profile-picture
