post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{identifier}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  bru.setVar("identifier", "");
  bru.setVar("password", fx.PASSWORD);
}

tests {
  test("status 422", function() {
    expect(res.getStatus()).to.equal(422);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/username/);
  });
}

