meta {
  name: LOG-EP-02 · email en mayúsculas como identificador → 200
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{identifier}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  const u = await fx.newUser(bru);
  bru.setVar("expectedUser", u.username);
  bru.setVar("identifier", u.email.toUpperCase());
  bru.setVar("password", u.password);
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a token and the user's Author node", function() {
    const body = res.getBody();
    expect(body.token).to.be.a("string").and.not.be.empty;
    expect(body.user.username).to.equal(bru.getVar("expectedUser"));
    expect(body.node.author_id).to.equal(body.user.id);
  });
}

docs {
  # LOG-EP-02 · email en mayúsculas como identificador → 200

  **Técnica:** EP

  **Cubre:** Partición válida: identificador = email (en mayúsculas; no distingue mayúsculas).

  **Esperado:** 200
}
