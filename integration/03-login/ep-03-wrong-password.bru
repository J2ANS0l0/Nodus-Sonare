meta {
  name: LOG-EP-03 · contraseña incorrecta → 401
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{identifier}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  const u = await fx.newUser(bru);
  bru.setVar("expectedUser", u.username);
  bru.setVar("identifier", u.username);
  bru.setVar("password", "wrong-" + u.password);
}

tests {
  test("status 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("same message for wrong password and unknown user", function() {
    expect(res.getBody()).to.eql({ error: "Invalid credentials" });
  });
}

docs {
  # LOG-EP-03 · contraseña incorrecta → 401

  **Técnica:** EP

  **Cubre:** Partición inválida: usuario existente, contraseña incorrecta.

  **Esperado:** 401 `Invalid credentials`
}
