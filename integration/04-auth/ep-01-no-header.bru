meta {
  name: AUTH-EP-01 · sin header Authorization → 401
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/album/upload
  body: json
  auth: none
}

body:json {
  {
    "album_name": "Auth probe",
    "author_name": "Integration",
    "tracks": [{ "name": "T", "url": "it://t" }]
  }
}

tests {
  test("status 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/Missing access token/);
  });
}

docs {
  # AUTH-EP-01 · sin header Authorization → 401

  **Técnica:** EP

  **Cubre:** Partición inválida del token: ausente. Se prueba sobre `POST /api/album/upload`; todos los endpoints protegidos usan la misma dependencia.

  **Esperado:** 401 `Missing access token`
}
