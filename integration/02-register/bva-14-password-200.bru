meta {
  name: REG-BVA-14 · password 200 caracteres → 400
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  bru.setVar("email", `it_${fx.suffix()}@example.com`);
  bru.setVar("username", `it_${fx.suffix()}`);
  bru.setVar("password", "a".repeat(200));
}

tests {
  test("status 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/at most 72 bytes/);
  });
}

docs {
  # REG-BVA-14 · password 200 caracteres → 400

  **Técnica:** BVA

  **Cubre:** Máximo del schema, lado válido (200): pasa el schema y lo rechaza el servicio (400, no 422).

  **Esperado:** 400

  Límites de `password`: el schema exige 1–200 caracteres (fuera → 422); el servicio exige al menos 6 caracteres y a lo más 72 **bytes** UTF-8, el límite de bcrypt (fuera → 400).
}
