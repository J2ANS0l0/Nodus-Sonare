meta {
  name: REG-EP-03 · username con caracteres no permitidos → 400
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  bru.setVar("email", `it_${fx.suffix()}@example.com`);
  bru.setVar("username", `it@${fx.suffix()}`);
  bru.setVar("password", fx.PASSWORD);
}

tests {
  test("status 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/Username must be 2-40 characters/);
  });
}

docs {
  # REG-EP-03 · username con caracteres no permitidos → 400

  **Técnica:** EP

  **Cubre:** Partición inválida de `username`: longitud válida pero con `@`, fuera del alfabeto (letras, números, espacio, `. _ -`).

  **Esperado:** 400
}
