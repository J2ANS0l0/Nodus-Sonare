meta {
  name: REG-BVA-13 · password 36 × ñ + a (37 caracteres, 73 bytes) → 400
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  bru.setVar("email", `it_${fx.suffix()}@example.com`);
  bru.setVar("username", `it_${fx.suffix()}`);
  bru.setVar("password", "ñ".repeat(36) + "a");
}

tests {
  test("status 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/at most 72 bytes/);
  });
}

docs {
  # REG-BVA-13 · password 36 × ñ + a (37 caracteres, 73 bytes) → 400

  **Técnica:** BVA

  **Cubre:** Máximo de bcrypt, lado inválido: solo 37 caracteres pero 73 bytes. Demuestra que el límite cuenta bytes y no caracteres.

  **Esperado:** 400

  Límites de `password`: el schema exige 1–200 caracteres (fuera → 422); el servicio exige al menos 6 caracteres y a lo más 72 **bytes** UTF-8, el límite de bcrypt (fuera → 400).
}
