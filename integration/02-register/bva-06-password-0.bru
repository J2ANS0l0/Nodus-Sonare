meta {
  name: REG-BVA-06 · password 0 caracteres → 422
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  bru.setVar("email", `it_${fx.suffix()}@example.com`);
  bru.setVar("username", `it_${fx.suffix()}`);
  bru.setVar("password", "");
}

tests {
  test("status 422", function() {
    expect(res.getStatus()).to.equal(422);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/password/);
  });
}

docs {
  # REG-BVA-06 · password 0 caracteres → 422

  **Técnica:** BVA

  **Cubre:** Límite inferior del schema, lado inválido (0 < 1).

  **Esperado:** 422

  Límites de `password`: el schema exige 1–200 caracteres (fuera → 422); el servicio exige al menos 6 caracteres y a lo más 72 **bytes** UTF-8, el límite de bcrypt (fuera → 400).
}
