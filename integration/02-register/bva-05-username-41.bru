meta {
  name: REG-BVA-05 · username 41 caracteres → 422
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  bru.setVar("email", `it_${fx.suffix()}@example.com`);
  bru.setVar("username", fx.uniqueName(41));
  bru.setVar("password", fx.PASSWORD);
}

tests {
  test("status 422", function() {
    expect(res.getStatus()).to.equal(422);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/username/);
  });
}

docs {
  # REG-BVA-05 · username 41 caracteres → 422

  **Técnica:** BVA

  **Cubre:** Límite superior, lado inválido (41 > 40).

  **Esperado:** 422

  Límites de `username`: el schema exige 1–40 caracteres (fuera → 422) y el servicio 2–40 (1 → 400). Cada lado de cada límite da un código distinto.
}
