meta {
  name: REG-BVA-12 · password 36 × ñ (72 bytes) → 201
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  bru.setVar("email", `it_${fx.suffix()}@example.com`);
  bru.setVar("username", `it_${fx.suffix()}`);
  bru.setVar("password", "ñ".repeat(36));
}

tests {
  test("status 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns token, user and Author node linked to the user", function() {
    const body = res.getBody();
    expect(body.token).to.be.a("string").and.not.be.empty;
    expect(body.user.username).to.equal(bru.getVar("username"));
    expect(body.user).to.not.have.property("password_hash");
    expect(body.node.node_type).to.equal("Author");
    expect(body.node.author_id).to.equal(body.user.id);
  });
}

docs {
  # REG-BVA-12 · password 36 × ñ (72 bytes) → 201

  **Técnica:** BVA

  **Cubre:** Máximo de bcrypt contado en bytes, lado válido: 36 caracteres de 2 bytes = 72 bytes.

  **Esperado:** 201

  Límites de `password`: el schema exige 1–200 caracteres (fuera → 422); el servicio exige al menos 6 caracteres y a lo más 72 **bytes** UTF-8, el límite de bcrypt (fuera → 400).
}
