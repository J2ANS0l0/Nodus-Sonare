meta {
  name: HEA-EP-02 · palette → 12 colores
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/palette
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("12 distinct lowercase hex colors", function() {
    const colors = res.getBody().colors;
    expect(colors).to.have.lengthOf(12);
    colors.forEach((c) => expect(c).to.match(/^#[0-9a-f]{6}$/));
    expect(new Set(colors).size).to.equal(12);
  });
}

docs {
  # HEA-EP-02 · palette → 12 colores

  **Técnica:** EP

  **Cubre:** Partición válida del catálogo de colores que luego usa la tabla de decisión de perfil.

  **Esperado:** 200 con 12 colores hex distintos en minúsculas
}
