meta {
  name: ALB-EP-03 · nombre de álbum en blanco → 400
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/album/upload
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "album_name": "  ",
    "author_name": "Integration",
    "tracks": [{ "name": "T", "url": "it://t" }]
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  const u = await fx.newUser(bru);
  bru.setVar("token", u.token);
  bru.setVar("authorNodeId", u.nodeId);
  bru.setVar("suffix", fx.suffix());
}

tests {
  test("status 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/Album name and author name are required/);
  });
}

docs {
  # ALB-EP-03 · nombre de álbum en blanco → 400

  **Técnica:** EP

  **Cubre:** Partición inválida de `album_name`: solo espacios.

  **Esperado:** 400
