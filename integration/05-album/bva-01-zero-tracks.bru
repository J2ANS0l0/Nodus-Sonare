post {
  url: {{baseUrl}}/api/album/upload
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "album_name": "Album {{suffix}}",
    "author_name": "Integration",
    "tracks": []
  }
}

script:pre-request {
  const fx = require("./lib/fixtures");
  const u = await fx.newUser(bru);
  bru.setVar("token", u.token);
  bru.setVar("authorNodeId", u.nodeId);
  bru.setVar("suffix", fx.suffix());
}

tests {
  test("status 422", function() {
    expect(res.getStatus()).to.equal(422);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/tracks/);
  });
}

