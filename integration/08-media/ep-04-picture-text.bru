meta {
  name: MED-EP-04 · archivo de texto como foto → 400
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/profile/picture
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  file: @file(fixtures/note.txt) @contentType(text/plain)
}

script:pre-request {
  const fx = require("./lib/fixtures");
  const u = await fx.newUser(bru);
  bru.setVar("token", u.token);
  bru.setVar("authorNodeId", u.nodeId);
}

tests {
  test("status 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error body {\"error\": ...}", function() {
    expect(res.getBody()).to.have.property("error").that.is.a("string");
    expect(res.getBody().error).to.match(/Unsupported image type/);
  });
}

docs {
  # MED-EP-04 · archivo de texto como foto → 400

